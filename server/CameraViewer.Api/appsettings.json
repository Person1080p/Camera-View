{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://0.0.0.0:5080",
  "Storage": {
    "DataPath": "App_Data"
  },
  "Ffmpeg": {
    "Path": ""
  },
  "Streaming": {
    "LiveIdleSeconds": 30,
    "PlaybackIdleSeconds": 45,
    "PlaybackWindowHours": 3,
    "MaxSessions": 40
  },
  "Exports": {
    "MaxMinutes": 120,
    "MaxConcurrent": 2
  },
  "Seed": {
    "AdminUsername": "admin",
    "AdminPassword": "admin",
    "Devices": []
  }
}
